generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  bio              String?   @default("")
  cashThb          Float     @default(1250000)
  cashUsd          Float     @default(0)
  username         String?   @unique
  passwordHash     String?
  lastNameChangeAt DateTime?
  bannedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  holdings           Holding[]
  tradeHistory       Trade[]
  posts              Post[]
  likes              Like[]
  comments           Comment[]
  bookmarks          Bookmark[]
  following          Follow[]            @relation("Follower")
  followers          Follow[]            @relation("Following")
  watchlist          WatchlistItem[]
  chatMessages       ChatMessage[]
  priceAlerts        PriceAlert[]
  notifications      Notification[]
  portfolioSnapshots PortfolioSnapshot[]
  pushSubscriptions  PushSubscription[]
  journeyProgress    JourneyProgress?
  limitOrders        LimitOrder[]
  optionPositions    OptionPosition[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  shares    Float
  avgCost   Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  side      String // "BUY" | "SELL"
  shares    Float
  price     Float
  total     Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id           String   @id @default(cuid())
  userId       String
  content      String
  ticker       String?
  topic        String?
  quotedPostId String?
  quoteCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      Like[]
  comments   Comment[]
  bookmarks  Bookmark[]
  quotedPost Post?      @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes     Post[]     @relation("PostQuotes")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies Comment[] @relation("Replies")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  ticker      String
  threshold   Float
  condition   String // "above" | "below"
  triggered   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticker, triggered])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "like" | "comment" | "follow" | "alert"
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model SiteCache {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  authorId  String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model PortfolioSnapshot {
  id        String   @id @default(cuid())
  userId    String
  valueThb  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Guided learning journey progress per user.
// completedSteps is a JSON array of step IDs (e.g. ["foundations","radar","first-trade"]).
model JourneyProgress {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedSteps   String    @default("[]")
  readinessDone    Boolean   @default(false)
  readinessSkipped Boolean   @default(false)
  firstTradeAt     DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// Trade thesis — user's reasoning attached to a paper trade.
// Private to the user; used for Martin's learning review.
model TradeThesis {
  id         String    @id @default(cuid())
  tradeId    String    @unique
  userId     String
  thesis     String    @default("")
  tags       String    @default("[]")   // JSON array of tag strings
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([tradeId])
}

// Paper-trading limit orders — filled when price crosses threshold.
model LimitOrder {
  id          String    @id @default(cuid())
  userId      String
  ticker      String
  side        String    // "BUY" | "SELL"
  shares      Float
  limitPrice  Float
  status      String    @default("PENDING") // "PENDING" | "FILLED" | "CANCELLED"
  createdAt   DateTime  @default(now())
  filledAt    DateTime?
  filledPrice Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, status])
}

// Paper-trading options positions (simulated Call/Put).
model OptionPosition {
  id          String    @id @default(cuid())
  userId      String
  ticker      String
  optionType  String    // "CALL" | "PUT"
  strikePrice Float
  expiry      DateTime
  contracts   Int       // each contract covers 100 shares
  premium     Float     // price paid per share at open
  totalCost   Float     // premium * contracts * 100
  status      String    @default("OPEN") // "OPEN" | "CLOSED" | "EXPIRED"
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  closedPrice Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, status])
}

// Pre-computed radar scan results — one row per universe (SP500 / NASDAQ100 / CEO).
// Written by the /api/cron/radar-precompute job; read by /api/radar/scan on every request.
// Keyed on universe string so upsert is always a single-row update.
model RadarScan {
  universe  String   @id
  results   Json
  total     Int
  scannedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
